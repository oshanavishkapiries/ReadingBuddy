# JWT secret key for signing session tokens
# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./readingbuddy.db

# Backend OpenRouter API key (fallback when users don't have their own key)
OPENROUTER_API_KEY=

# Default OpenRouter model (users can override in Settings)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Daily free-tier job limit per user (applies when using the backend API key)
DAILY_LIMIT=100

# Maximum pages per PDF document allowed for processing
PAGE_LIMIT=50
