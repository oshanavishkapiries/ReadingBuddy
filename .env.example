# JWT secret key for signing session tokens
# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./readingbuddy.db

# Backend OpenRouter API key (fallback when users don't have their own key)
OPENROUTER_API_KEY=

# Default OpenRouter model (users can override in Settings)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Drive Storage
# Root folder ID in Google Drive where all app data will be stored
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Service Account credentials JSON as base64
# Generate with: base64 -w 0 credentials.json
GOOGLE_DRIVE_CREDENTIALS_B64=
